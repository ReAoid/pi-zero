{
  "name": "pi-zero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node bash/kill-port.cjs 3000 && tsx server/index.ts\" \"tsc --watch --project tsconfig.client.json\"",
    "predev": "node bash/kill-port.cjs 3000",
    "build": "tsc --project tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit --project tsconfig.client.json",
    "setup:posix": "node bash/setup-posix.js",
    "setup": "npm run setup:posix",
    "postinstall": "node bash/setup-posix.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@hono/node-server": "^2.0.4",
    "express": "^4.21.0",
    "hono": "^4.12.23",
    "typebox": "^1.1.38",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
