node_modules/
dist/
.env
*.log
.idea

# POSIX 命令环境（bash/）
# busybox64.exe 和 setup-posix.js 提交到 git，其他 applet 硬链接忽略
bash/*
!/bash/busybox64.exe
!/bash/setup-posix.js

# Workplace 文件（保留 .gitkeep）
workplace/*
!workplace/.gitkeep

# Data 文件（保留 .gitkeep）
data/**

!data/config/
!data/sessions/

!data/.gitkeep
!data/config/.gitkeep
!data/sessions/.gitkeep
